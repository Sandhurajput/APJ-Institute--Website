{
  "buildCommand": "npm install --prefix client && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "env": {
    "VITE_API_URL": "https://apj-institute-website.onrender.com",
    "VITE_GOOGLE_CLIENT_ID": ""
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}